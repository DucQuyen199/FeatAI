APP_ENV=development
POSTGRES_DB=aicount_guard
POSTGRES_USER=aicount
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql://aicount:replace_with_a_strong_password@postgres:5432/aicount_guard
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=aicount_minio
MINIO_SECRET_KEY=replace_with_a_strong_password
MINIO_BUCKET=aicount-documents
S3_SSE_ENABLED=false
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
INTERNAL_API_KEY=replace_with_a_random_service_key
MAX_UPLOAD_BYTES=20971520
ACCOUNT_FILE_MAX_BYTES=26214400
ACCOUNT_STORAGE_QUOTA_BYTES=524288000
RULE_ALLOW_DRAFT=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
